{
  "name": "dsh-omni-bridge",
  "version": "0.2.0",
  "description": "Multi-channel message bridge for DeepSeek Harness (DSH): route WeChat (ClawBot/iLink), QQ, and Feishu (Lark) chat messages to a DSH agent and relay its replies back. 多通道桥接：微信 ClawBot / QQ / 飞书消息接入 DSH agent 并回传回复。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baisama-cloud/dsh-omni-bridge.git"
  },
  "homepage": "https://github.com/baisama-cloud/dsh-omni-bridge",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "bridge",
    "wechat",
    "clawbot",
    "qq",
    "feishu",
    "lark",
    "chat-bot"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
